<?xml version="1.0" encoding="utf-8"?>
<!-- 允许明文 HTTP：控制台与 NapCat 都走 127.0.0.1 的 http -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

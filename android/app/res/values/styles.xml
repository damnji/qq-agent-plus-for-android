<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色主题（与 qq-agent-plus 控制台观感一致） -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#1E88E5</item>
        <item name="android:colorPrimaryDark">#0D47A1</item>
        <item name="android:colorAccent">#42A5F5</item>
        <item name="android:windowBackground">#FF12161C</item>
        <item name="android:statusBarColor">#FF12161C</item>
        <item name="android:navigationBarColor">#FF12161C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFE6EDF3</item>
    </style>

    <style name="CardBody">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#FF9BA7B4</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="PrimaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">#FF1E88E5</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="SecondaryButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#FF64B5F6</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
